# Copy this file to ".env" and adjust as needed:  cp .env.example .env
# The real ".env" is git-ignored — never commit secrets.

# --- App ---
APP_NAME=Multi-Agent Research Intelligence Platform
ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call the API (Angular dev server, etc.)
CORS_ORIGINS=http://localhost:4200

# --- Ports (host side) ---
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research

# --- Database URL ---
# Used by the backend. Inside docker-compose the host is the "db" service.
# For running the app directly on your machine, use "localhost" instead of "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/research

# --- Auth / JWT ---
# CHANGE THIS in any real environment (long, random secret).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-please-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- First admin bootstrap (seeded on startup if both are set) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator

# --- LLM (Milestone 6, step 2) ---
# Provider used by the agent's synthesis step: "openai" | "gemini" | "none".
# With "none" (or missing key) the agent falls back to a deterministic stub report.
LLM_PROVIDER=none
# Put your real keys ONLY in .env (git-ignored) — never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tip: model names change over time and vary by key. If you get a 404
# "model not found / not available to new users", list yours with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# --- MCP tools (Milestone 6, step 4) ---
# When true, research/citation/compliance run on the MCP server container
# (falls back to local tools if it's unreachable).
MCP_ENABLED=true
MCP_SERVER_URL=http://mcp:8090/mcp
