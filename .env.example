# Copy this file to ".env" and adjust as needed:  cp .env.example .env
# The real ".env" is git-ignored — never commit secrets.

# --- App ---
APP_NAME=Multi-Agent Research Intelligence Platform
ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call the API (Angular dev server, etc.)
CORS_ORIGINS=http://localhost:4200

# --- Ports (host side) ---
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research

# --- Database URL ---
# Used by the backend. Inside docker-compose the host is the "db" service.
# For running the app directly on your machine, use "localhost" instead of "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/research

# --- Auth / JWT ---
# CHANGE THIS in any real environment (long, random secret).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-please-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- First admin bootstrap (seeded on startup if both are set) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator
